{
  "name": "openhouse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "OpenChamber-lite: a lightweight project/session manager on top of OpenCode v2",
  "scripts": {
    "openhouse": "bun run src/cli.ts",
    "dev:core": "bun run src/cli.ts serve",
    "dev:ui": "vite --config ui/vite.config.ts",
    "build:ui": "vite build --config ui/vite.config.ts",
    "build:electron": "bun build electron/main.ts --target node --format cjs --outfile dist/electron-main.cjs --external electron",
    "electron": "bun run build:electron && electron dist/electron-main.cjs",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@opencode/client": "2.0.11",
    "@opencode/schema": "2.0.11",
    "croner": "^9.0.0",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
